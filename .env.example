# --- Supabase (auth + database) -------------------------------------------
# From your Supabase project: Settings -> API.
# Leave these unset to run the public site on localhost from bundled seed data
# (admin login/editing requires them).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required ONLY by `npm run seed` (bypasses RLS to bulk-insert).
# Never expose this to the browser; never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ------------------------------------------------------------------
# Canonical URL used for metadata, sitemap.xml, and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep "false" while lists contain placeholder content: the site serves
# noindex/robots-disallow so thin placeholder pages never get crawled.
# Flip to "true" once real content is in place.
NEXT_PUBLIC_SITE_INDEXABLE=false
